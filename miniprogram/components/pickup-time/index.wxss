.pickup-picker {
  margin-top: 12rpx;
  color: #293d30;
}

.pickup-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 25rpx;
  font-weight: 600;
}

.pickup-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.pickup-choice {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  gap: 5rpx;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  min-height: 44px;
  margin: 0;
  padding: 13rpx 16rpx;
  border: 1rpx solid #e6e9df;
  border-radius: 16rpx;
  background: #f8f8f3;
  color: #34473a;
  line-height: 1.35;
  text-align: left;
}

.pickup-choice::after,
.pickup-text-button::after {
  border: 0;
}

.pickup-choice.pickup-selected {
  border-color: #88a588;
  background: #e8f0e3;
  color: #28543b;
}

.pickup-date-name,
.pickup-slot-time {
  font-size: 27rpx;
  font-weight: 600;
}

.pickup-slot-time {
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.pickup-caption {
  color: #627461;
  font-size: 21rpx;
}

.pickup-date-check {
  position: absolute;
  top: 50%;
  right: 16rpx;
  transform: translateY(-50%);
  color: #386647;
  font-size: 24rpx;
}

.pickup-slot-heading {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-top: 24rpx;
}

.pickup-empty {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  padding: 16rpx;
  border-radius: 14rpx;
  background: #f2f3eb;
  color: #667661;
  font-size: 23rpx;
}

.pickup-text-button {
  width: auto;
  min-height: 36px;
  margin: 0;
  padding: 6rpx 10rpx;
  border: 0;
  background: transparent;
  color: #315c40;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.4;
}

.pickup-more {
  width: 100%;
  margin-top: 8rpx;
  text-align: center;
}
