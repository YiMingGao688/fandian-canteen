page{background:#f8f7f1;color:#25382b;font-family:-apple-system,BlinkMacSystemFont,"Microsoft YaHei",sans-serif;font-size:28rpx;line-height:1.5}view,text,input,textarea,button{box-sizing:border-box}button{font-size:27rpx;border-radius:16rpx;line-height:1.45;padding:22rpx 28rpx;margin:0}button::after{border:0}button[disabled]{opacity:.5}.page{padding:30rpx 28rpx 48rpx}.title{font-size:44rpx;font-weight:650;letter-spacing:1rpx}.eyebrow{font-size:20rpx;letter-spacing:3rpx;color:#8a7653;margin-bottom:10rpx}.muted{color:#788370;font-size:24rpx}.tiny{font-size:22rpx;color:#8b9383}.heading{display:flex;justify-content:space-between;align-items:center;margin:34rpx 0 20rpx}.heading text:first-child{font-weight:600;font-size:32rpx}.row{display:flex;align-items:center;gap:18rpx}.between{justify-content:space-between}.card{background:#fffefa;border:1rpx solid #e9eadf;border-radius:24rpx;padding:28rpx;margin-bottom:22rpx}.primary{background:#294f39;color:#fff}.soft{background:#eaf0e1;color:#35563a}.outline{background:transparent;color:#456043;border:1rpx solid #d7dfcf}.link{background:transparent;padding:10rpx 0;color:#45673c;font-size:25rpx}.danger{color:#a36549}.full{width:100%;margin-top:24rpx}.empty{padding:80rpx 26rpx;text-align:center;color:#7a8774}.empty .primary{margin:30rpx auto;max-width:360rpx}.pill{padding:7rpx 16rpx;border-radius:30rpx;background:#edf2e4;color:#566f43;font-size:22rpx}.price{font-weight:650;font-size:34rpx;color:#9b693b}.field{margin-top:24rpx}.label{display:block;color:#596a52;font-size:25rpx;margin-bottom:12rpx}input,.select,textarea{width:100%;border:1rpx solid #dfe5d6;border-radius:14rpx;background:#fafbf6;padding:22rpx;color:#334a35}input{height:88rpx}textarea{min-height:160rpx}.chips{white-space:nowrap;margin:24rpx 0}.chip{display:inline-block;padding:15rpx 24rpx;margin-right:12rpx;border-radius:28rpx;color:#7a8571;font-size:25rpx;background:#efefe7}.chip.active{background:#294f39;color:#fff}.modal-mask{position:fixed;top:0;right:0;bottom:0;left:0;background:rgba(12,30,19,.45);z-index:30;display:flex;align-items:flex-end}.sheet{width:100%;max-height:88vh;overflow:auto;background:#fffef9;border-radius:30rpx 30rpx 0 0;padding:32rpx 28rpx 64rpx}.close{font-size:36rpx;padding:0 14rpx;background:transparent;color:#67785e}.split{border-top:1rpx solid #edf0e5;margin-top:24rpx;padding-top:24rpx}.note{font-size:23rpx;color:#86917d;line-height:1.8;margin:24rpx 0}.error{padding:20rpx 24rpx;border-radius:14rpx;background:#fff0e7;color:#985b3d;margin:22rpx 0;font-size:25rpx}


/* 浮动底栏、标签页留白和餐盘共用同一组尺寸。 */
page {
  --hexu-tab-height: 60px;
  --hexu-tab-bottom: calc(8px + env(safe-area-inset-bottom, 0px));
  --hexu-tab-top: calc(var(--hexu-tab-bottom) + var(--hexu-tab-height));
}

.page.tab-page {
  padding-bottom: 88px;
  padding-bottom: calc(var(--hexu-tab-top) + 20px);
}

.modal-mask .sheet {
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom, 0px));
}
