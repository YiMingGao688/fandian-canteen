@import "../styles/bottom-dock.wxss";

/* 导航常驻底部，四个入口在未选中时也保留文字。 */
.meal-tab-bar {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  box-sizing: border-box;
  max-width: 580px;
  height: var(--tab-space, 54px);
  margin: 0 auto;
  padding: 3px 10px var(--safe-bottom);
  border-top: 1px solid #e9eae7;
  background: #fff;
}

.meal-tab-item {
  display: flex;
  flex: 1 1 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1px;
  box-sizing: border-box;
  width: auto;
  min-width: 44px;
  min-height: 44px;
  margin: 0;
  padding: 0 3px;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: #586155;
  line-height: 1.25;
}

.meal-tab-item::after { border: 0; }
.meal-tab-current { color: #12663e; }
.meal-tab-pressed { opacity: .72; }

.meal-tab-symbol {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 26px;
  border-radius: 9px;
}
.meal-tab-current .meal-tab-symbol { background: #e9f4e5; }
.meal-tab-icon { display: block; width: 20px; height: 20px; }
.meal-tab-label { font-size: 11px; white-space: nowrap; }
.meal-tab-current .meal-tab-label { font-weight: 700; }
