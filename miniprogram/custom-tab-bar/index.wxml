<view wx:if="{{!hidden}}" class="meal-tab-bar dock-metrics" aria-label="底部导航">
  <button
    wx:for="{{tabs}}"
    wx:key="pagePath"
    class="meal-tab-item {{selected === index ? 'meal-tab-current' : ''}}"
    data-index="{{index}}"
    bindtap="openTab"
    hover-class="meal-tab-pressed"
    hover-start-time="12"
    hover-stay-time="75"
    aria-label="{{item.text + (selected === index ? '，当前标签' : '')}}"
  >
    <view class="meal-tab-symbol">
      <image class="meal-tab-icon" src="{{'/assets/tab-bar/' + item.icon + (selected === index ? '-selected.svg' : '.svg')}}" mode="aspectFit" aria-hidden="true" />
    </view>
    <text class="meal-tab-label">{{item.text}}</text>
  </button>
</view>
