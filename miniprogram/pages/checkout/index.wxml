<view class="page checkout-page">
  <view class="checkout-header">
    <view class="row between">
      <view class="checkout-title">安排取餐</view>
      <text wx:if="{{cart.length}}" class="pill checkout-badge">到窗自取</text>
    </view>
    <view wx:if="{{cart.length && window}}" class="checkout-window">
      <text class="checkout-window-name">{{window.name}}</text>
      <text class="checkout-location">{{window.location || window.canteenName}}</text>
    </view>
  </view>

  <view wx:if="{{!cart.length}}" class="empty">餐盘是空的，请返回点餐页选菜。</view>
  <block wx:else>
    <view wx:if="{{cartError}}" class="checkout-alert" role="alert">
      <text class="checkout-alert-text">{{cartError}}</text>
      <view class="checkout-alert-actions">
        <button wx:if="{{hasInvalid}}" class="checkout-alert-button" disabled="{{busy}}" bindtap="removeInvalid">移除失效菜品</button>
        <button class="checkout-alert-button secondary" disabled="{{busy}}" bindtap="clearCart">清空餐盘</button>
      </view>
    </view>
    <view class="card checkout-card checkout-times">
      <pickup-time
        dates="{{dates}}"
        date-index="{{dateIndex}}"
        slots="{{slots}}"
        slot-index="{{slotIndex}}"
        loading="{{loadingSlots}}"
        failed="{{slotLoadFailed}}"
        busy="{{busy}}"
        bind:datechange="dateChange"
        bind:slotchange="slotChange"
        bind:retry="loadSlots"
      />
    </view>

    <view class="card checkout-card">
      <view class="checkout-section-title">餐盘明细</view>
      <view wx:for="{{cart}}" wx:key="id" class="checkout-item">
        <image class="checkout-item-image" src="{{item.image}}" mode="aspectFill" />
        <text class="checkout-item-name">{{item.name}}</text>
        <text wx:if="{{item.invalid}}" class="checkout-item-invalid">已下架</text>
        <text class="checkout-item-count">× {{item.number}}</text>
      </view>
    </view>

    <view class="card checkout-card">
      <view class="row between">
        <text class="checkout-section-title">备注</text>
        <text class="checkout-caption">选填</text>
      </view>
      <textarea class="checkout-remark" value="{{remark}}" bindinput="remark" maxlength="100" placeholder="例如：少辣，不要香菜" />
      <view class="row between checkout-cutlery">
        <text>需要餐具</text>
        <switch checked="{{cutlery}}" color="#294f39" bindchange="cutlery" />
      </view>
    </view>

    <view class="checkout-footer">
      <view class="checkout-total">
        <text class="checkout-caption">合计</text>
        <text class="checkout-price">¥{{total}}</text>
      </view>
      <button
        class="checkout-submit"
        disabled="{{busy || loadingSlots || cartError || slotIndex < 0}}"
        bindtap="submit"
      >{{busy ? '正在提交…' : cartError ? '请先处理餐盘' : loadingSlots ? '正在读取时段…' : slotLoadFailed ? '请重试加载时段' : slotIndex < 0 ? '暂无可选时段' : '确认预约'}}</button>
    </view>
  </block>
</view>
