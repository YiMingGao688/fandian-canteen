/* 预约底栏与正文留白共用尺寸，窄屏也能完整显示备注和餐具选项。 */
.checkout-page {
  --checkout-bar: 70px;
  min-height: 100vh;
  padding: 12px 14px calc(var(--checkout-bar) + var(--safe-bottom) + 16px);
}

.checkout-card {
  min-width: 0;
  margin-bottom: 10px;
  padding: 14px;
  border: 1px solid var(--line);
  border-radius: 15px;
  background: #fff;
}
.pickup-card { padding-top: 0; }
.checkout-window {
  display: flex;
  align-items: center;
  gap: 9px;
  min-height: 67px;
  margin-bottom: 11px;
  padding: 11px 0;
  border-bottom: 1px solid var(--line);
}
.checkout-window-symbol { display: flex; flex: none; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 11px; background: var(--mint); }
.checkout-window-symbol image { width: 23px; height: 23px; }
.checkout-window-copy { flex: 1; min-width: 0; }
.checkout-window-name, .checkout-location { display: block; overflow-wrap: anywhere; }
.checkout-window-name { color: var(--ink); font-size: 19px; font-weight: 750; line-height: 1.3; }
.checkout-location { margin-top: 2px; color: var(--muted); font-size: 13px; }
.checkout-mode { flex: none; padding: 4px 7px; border-radius: 6px; background: var(--mint); color: var(--forest); font-size: 12px; font-weight: 650; }

.checkout-section-heading { margin-bottom: 2px; }
.checkout-section-title { color: var(--ink); font-size: 16px; font-weight: 750; }
.checkout-caption, .checkout-item-count { color: var(--muted); font-size: 13px; }
.checkout-caption { flex: none; }
.checkout-item { display: flex; align-items: center; gap: 9px; padding: 9px 0; }
.checkout-item:last-child { padding-bottom: 0; }
.checkout-item + .checkout-item { border-top: 1px solid var(--line); }
.checkout-item-image { flex: none; width: 53px; height: 53px; border-radius: 9px; background: var(--mint); }
.checkout-item-placeholder { display: flex; align-items: center; justify-content: center; }
.checkout-item-placeholder image { width: 23px; height: 23px; opacity: .7; }
.checkout-item-copy { flex: 1; min-width: 0; }
.checkout-item-name, .checkout-item-count { display: block; overflow-wrap: anywhere; }
.checkout-item-name { color: var(--ink); font-size: 15px; font-weight: 650; }
.checkout-item-stock { display: block; color: #794e22; font-size: 12px; }
.checkout-item-amount { max-width: 35%; color: var(--ink); font-size: 16px; font-weight: 750; font-variant-numeric: tabular-nums; text-align: right; overflow-wrap: anywhere; }
.checkout-remark { height: 65px; min-height: 65px; margin-top: 8px; padding: 9px 11px; border-radius: 9px; font-size: 14px; }
.checkout-cutlery { min-height: 43px; margin-top: 10px; padding-top: 7px; border-top: 1px solid var(--line); font-size: 14px; }
.checkout-payment-note { display: block; padding: 0 3px; color: var(--muted); font-size: 12px; }

.checkout-footer {
  position: fixed;
  z-index: 5;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  gap: 14px;
  max-width: 580px;
  min-height: calc(var(--checkout-bar) + var(--safe-bottom));
  margin: 0 auto;
  padding: 9px 14px calc(9px + var(--safe-bottom));
  border-top: 1px solid var(--line);
  background: #fff;
  box-shadow: 0 -5px 18px rgba(31, 50, 28, .05);
}
.checkout-total { display: flex; flex-direction: column; min-width: 0; max-width: 45%; line-height: 1.2; }
.checkout-price { color: var(--ink); font-size: 25px; font-weight: 750; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.checkout-submit { flex: 1; width: auto; min-height: 49px; }

.checkout-state { margin: 0; padding: 32px 16px; color: var(--muted); text-align: center; }
.checkout-retry { width: auto; margin: 12px auto 0; }
.checkout-alert { margin-bottom: 10px; padding: 13px; border: 1px solid #eadcc4; border-radius: 13px; background: #fcf6e9; color: #754d27; font-size: 14px; }
.checkout-alert-text { display: block; overflow-wrap: anywhere; }
.checkout-alert-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 9px; }
.checkout-alert-button { flex: 1 1 110px; min-width: 0; padding: 7px 9px; border-radius: 9px; background: #7f542e; color: #fff; font-size: 14px; font-weight: 650; }
.checkout-alert-button.secondary { border: 1px solid #eadcc4; background: #fff; color: #754d27; }
.checkout-item-invalid { flex: none; padding: 3px 7px; border-radius: 6px; background: #f6ebd9; color: #794e22; font-size: 12px; }

@media (max-width: 350px) {
  .checkout-page { padding-right: 11px; padding-left: 11px; }
  .checkout-card { padding-right: 11px; padding-left: 11px; }
  .checkout-window { gap: 7px; }
  .checkout-window-name { font-size: 17px; }
  .checkout-price { font-size: 22px; }
}
