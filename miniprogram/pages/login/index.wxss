page { background: #111310; color: #fff; }
.login-page { display: flex; flex-direction: column; width: 100%; max-width: 580px; min-height: 100vh; margin: 0 auto; }
.login-cover {
  position: relative;
  display: flex;
  flex: 1 0 auto;
  align-items: flex-end;
  min-height: 236px;
  height: 43vh;
  max-height: 490px;
  max-height: min(58vh, 490px);
  overflow: hidden;
  background: #34382f;
}
.login-cover image, .login-cover-shade { position: absolute; top: 0; right: 0; bottom: 0; left: 0; width: 100%; height: 100%; }
.login-cover-shade { background: linear-gradient(180deg, transparent 24%, rgba(17, 19, 16, .15) 49%, #111310 99%); }
.login-intro { position: relative; width: 100%; padding: 20px 24px 12px; }
.login-title {
  display: block;
  font-family: "Kaiti SC", STKaiti, KaiTi, "Songti SC", serif;
  font-size: 44px;
  font-weight: 500;
  line-height: 1.18;
}
.login-subtitle { display: block; margin-top: 8px; color: #e1e8df; font-size: 15px; }
.login-form { width: 100%; max-width: 460px; margin: 0 auto; padding: 0 24px 20px; padding-bottom: calc(20px + var(--safe-bottom)); }
.login-form .field { margin-top: 12px; }
.login-form .label { color: #f1f3ef; font-size: 14px; font-weight: 600; }
/* 输入框用水平内边距，保留原生输入文字的垂直居中。 */
.login-form .login-input { height: 48px; padding: 0 13px; border-color: #444b40; border-radius: 11px; background: #242922; color: #fff; }
.login-form .login-input-focused { border-color: #a9cd91; }
.login-placeholder, .login-form input::placeholder { color: #b0b9ad; opacity: 1; }
.login-password { position: relative; }
.login-password .login-input { padding-right: 66px; }
.login-form button.login-password-toggle {
  position: absolute;
  top: 1px;
  right: 1px;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60px;
  min-height: 46px;
  margin: 0;
  padding: 0 7px;
  border-radius: 0 10px 10px 0;
  background: transparent;
  color: #c5dcc9;
  font-size: 13px;
  font-weight: 600;
}
.login-form .login-field-invalid .login-input { border-color: #d27d63; }
.login-error { margin-top: 10px; color: #f4a690; font-size: 13px; line-height: 1.45; overflow-wrap: anywhere; }

/* 覆盖微信 v2 的按钮宽度，提交按钮与表单输入框对齐。 */
.login-form button.login-submit {
  position: relative;
  width: 100%;
  max-width: none;
  min-height: 48px;
  margin: 18px 0 0;
  padding: 8px 38px;
  border-radius: 11px;
  background: var(--lime);
  color: var(--lime-text);
  font-weight: 650;
}
.login-arrow { position: absolute; right: 15px; top: 50%; transform: translateY(-50%); font-size: 20px; }
.login-switch-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 3px; margin-top: 3px; color: #b7c7bb; font-size: 13px; }
.login-form button.login-switch { width: auto; margin: 0; padding: 7px 6px; border-radius: 6px; background: transparent; color: #d8e9dc; font-size: 14px; font-weight: 650; }

/* 注册表单在短屏上也优先完整展示。 */
.register-page {
  display: block;
  box-sizing: border-box;
  max-width: 100%;
  padding: 18px 16px calc(14px + var(--safe-bottom));
  background: var(--soft);
  color: var(--ink);
}
.register-intro {
  display: flex;
  align-items: center;
  gap: 13px;
  max-width: 460px;
  margin: 0 auto 12px;
  padding: 14px 15px;
  border-radius: 16px;
  background: #193d30;
  color: #fff;
}
.register-mark { display: flex; flex: none; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 12px; background: #e7f3e6; }
.register-mark image { width: 32px; height: 32px; }
.register-intro-copy { flex: 1; min-width: 0; }
.register-title, .register-subtitle { display: block; }
.register-title { font-size: 21px; font-weight: 700; line-height: 1.25; }
.register-subtitle { margin-top: 4px; color: #d2e5d9; font-size: 12px; }
.register-page .login-form { padding: 14px 15px 4px; border: 1px solid var(--line); border-radius: 16px; background: #fff; }
.register-page .field:first-child { margin-top: 0; }
.register-page .label { margin-bottom: 5px; color: var(--ink); }
.register-page .login-input { height: 44px; border-color: #e0e7df; background: #f5f7f4; color: var(--ink); }
.register-page .login-placeholder, .register-page input::placeholder { color: #626b62; }
.register-page .login-input-focused { border-color: #629772; }
.register-page button.login-password-toggle { min-height: 42px; color: var(--forest); }
.register-page .login-error { color: #a04632; }
.register-page .login-switch-row { color: var(--muted); }
.register-page button.login-switch { color: var(--forest); }
@media (max-height: 610px) {
  .login-cover { min-height: 198px; height: 39vh; max-height: 46vh; }
  .login-title { font-size: 37px; }
  .register-page { padding-top: 10px; }
  .register-intro { margin-bottom: 9px; padding-top: 10px; padding-bottom: 10px; }
  .register-page .field { margin-top: 8px; }
  .register-page .login-form button.login-submit { margin-top: 12px; }
}
