<view class="page"><view class="eyebrow">HEXU · CAMPUS DINING</view><view class="title">{{registering ? '一起，好好吃饭。' : '欢迎回到禾序。'}}</view><view class="note">使用学号登录，预约下一餐。</view><view class="card"><view class="field"><text class="label">学号</text><input value="{{username}}" data-field="username" bindinput="input" maxlength="16" placeholder="请输入学号"/></view><view wx:if="{{registering}}" class="field"><text class="label">怎么称呼你</text><input value="{{displayName}}" data-field="displayName" bindinput="input" maxlength="24" placeholder="2 至 24 字"/></view><view class="field"><text class="label">密码</text><input value="{{password}}" password data-field="password" bindinput="input" maxlength="64" placeholder="8 至 64 位密码"/></view><button class="primary full" loading="{{busy}}" disabled="{{busy}}" bindtap="submit">{{registering ? '注册并登录' : '登录禾序'}}</button><button class="link full" bindtap="toggle">{{registering ? '已有账号？返回登录' : '第一次来？用学号注册'}}</button></view></view>
