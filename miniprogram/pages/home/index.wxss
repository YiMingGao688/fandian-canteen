/* 微信 v2 的原生按钮样式会设置默认宽度与居中边距。给页面控件保留自己的尺寸。 */
.home button, .home-overlay button {
  width: auto;
  max-width: none;
  margin-right: 0;
  margin-left: 0;
}

/* 底栏和餐盘固定在可视区内，列表末尾预留同样高度。 */
.home {
  --store-inset: 14px;
  --menu-toolbar-height: 56px;
  --rail-width: 76px;
  --home-dock-space: calc(var(--tab-space) + var(--cart-height) + var(--dock-gap) * 2);
  --menu-visible: calc(100vh - var(--home-dock-space) - var(--menu-toolbar-height));
  width: 100%;
  max-width: 580px;
  min-height: 100vh;
  margin: 0 auto;
  padding: 10px 0 calc(var(--home-dock-space) + 4px);
  background: var(--soft);
}

.store-cover {
  position: relative;
  display: flex;
  align-items: center;
  height: clamp(134px, 41vw, 192px);
  margin: 0 var(--store-inset);
  padding: 10px 20px 16px;
  overflow: hidden;
  border-radius: 18px;
  background: #183522;
  color: #fff;
}

.store-cover-image { position: absolute; inset: 0; width: 100%; height: 100%; }
.store-cover-copy { position: relative; }
.store-cover-title { display: block; font-size: clamp(25px, 7vw, 33px); font-weight: 750; line-height: 1.15; }
.store-cover-accent { margin-top: 3px; color: var(--lime); }
.store-cover-caption { display: block; margin-top: 9px; color: #e7efe3; font-size: 12px; }

.store-card {
  position: relative;
  margin: -10px var(--store-inset) 0;
  padding: 10px 12px;
  border: 1px solid var(--line);
  border-radius: 15px;
  background: #fff;
  box-shadow: 0 3px 12px rgba(31, 50, 28, .045);
}
.store-identity { display: flex; align-items: center; gap: 10px; min-height: 44px; }
.store-mark {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 43px;
  height: 43px;
  border-radius: 12px;
  background: var(--mint);
}
.store-mark image { width: 26px; height: 26px; }
.store-labels { flex: 1; min-width: 0; }
.store-canteen, .store-name { display: block; overflow-wrap: anywhere; }
.store-canteen { color: var(--muted); font-size: 12px; line-height: 1.35; }
.store-name { color: var(--ink); font-size: 20px; font-weight: 700; line-height: 1.25; }
.store-switch {
  display: flex;
  flex: none;
  align-items: center;
  gap: 6px;
  padding: 7px 9px;
  border: 1px solid var(--line);
  border-radius: 8px;
  color: var(--forest);
  font-size: 12px;
  font-weight: 600;
}
.store-pickup {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 5px 9px;
  margin-top: 7px;
  padding-top: 7px;
  border-top: 1px solid var(--line);
}
.store-mode {
  padding: 2px 7px;
  border-radius: 5px;
  background: var(--mint);
  color: var(--forest);
  font-size: 12px;
  font-weight: 650;
}
.store-paused { background: #f5eee0; color: #7d542b; }
.store-location { min-width: 0; color: var(--muted); font-size: 12px; overflow-wrap: anywhere; }

.showcase { padding-top: 7px; }
.showcase-heading { display: flex; align-items: center; justify-content: space-between; padding: 0 var(--store-inset); }
.showcase-title { font-size: 17px; font-weight: 700; }
.showcase-menu {
  display: flex;
  align-items: center;
  gap: 6px;
  width: auto;
  min-height: 36px;
  padding: 0 2px 0 10px;
  background: transparent;
  color: var(--forest);
  font-size: 12px;
  font-weight: 650;
}
.showcase-scroll { width: 100%; }
.showcase-track { display: inline-flex; gap: 8px; padding: 0 var(--store-inset) 9px; }
.showcase-card {
  flex: 0 0 108px;
  width: 108px;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 11px;
  background: #fff;
}
.showcase-card .showcase-dish { display: block; width: 100%; min-height: 0; padding: 0; border-radius: 0; background: transparent; text-align: left; }
.showcase-image { position: relative; height: 66px; background: var(--mint); }
.showcase-count {
  position: absolute;
  top: 5px;
  right: 5px;
  padding: 1px 5px;
  border-radius: 5px;
  background: var(--dark);
  color: #fff;
  font-size: 11px;
  line-height: 1.4;
}
.showcase-name {
  display: block;
  padding: 6px 7px 0;
  overflow: hidden;
  color: var(--ink);
  font-size: 13px;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.showcase-buy { display: flex; align-items: center; justify-content: space-between; gap: 3px; padding: 2px 6px 5px 7px; }
.showcase-price { min-width: 0; font-size: 15px; font-weight: 750; line-height: 1.1; overflow-wrap: anywhere; }

.menu-start { background: #fff; }
.menu-tools {
  position: sticky;
  z-index: 4;
  top: 0;
  display: flex;
  align-items: center;
  gap: 8px;
  height: var(--menu-toolbar-height);
  padding: 8px var(--store-inset);
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  background: #fff;
}
.menu-search {
  display: flex;
  flex: 1;
  align-items: center;
  gap: 9px;
  min-width: 0;
  padding: 0 10px 0 12px;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: var(--soft);
  color: var(--muted);
}
.menu-search input { flex: 1; width: 0; height: 41px; padding: 0; border: 0; border-radius: 0; background: transparent; font-size: 14px; }
.menu-placeholder { color: var(--muted); }
.search-symbol { position: relative; flex: none; width: 14px; height: 14px; margin-right: 2px; border: 1.5px solid currentColor; border-radius: 50%; }
.search-symbol::after {
  position: absolute;
  right: -4px;
  bottom: -2px;
  width: 6px;
  height: 1.5px;
  background: currentColor;
  transform: rotate(45deg);
  content: "";
}
.menu-search .search-clear { flex: none; width: 28px; min-height: 36px; padding: 0; background: transparent; color: var(--muted); font-size: 21px; }
.menu-favorites {
  display: flex;
  flex: none;
  align-items: center;
  gap: 4px;
  width: auto;
  min-height: 43px;
  padding: 0 10px;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: #fff;
  color: var(--ink);
  font-size: 13px;
}
.menu-heart { font-size: 19px; line-height: 1; }
.menu-favorites-active { border-color: #b4d0a7; background: var(--mint); color: var(--forest); }

.menu-layout { display: flex; min-height: var(--menu-visible); }
.menu-with-rail { background: linear-gradient(90deg, var(--soft) 0 var(--rail-width), #fff var(--rail-width)); }
.category-rail { position: sticky; top: var(--menu-toolbar-height); flex: 0 0 var(--rail-width); align-self: flex-start; width: var(--rail-width); }
.category-scroll { width: 100%; height: var(--menu-visible); min-height: 120px; padding-top: 3px; }
.category-scroll .category-item {
  position: relative;
  display: block;
  width: 100%;
  min-height: 48px;
  padding: 10px 6px 10px 9px;
  border-radius: 0;
  background: transparent;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.35;
  overflow-wrap: anywhere;
}
.category-current { background: #fff; color: var(--forest); font-weight: 700; }
.category-current::before {
  position: absolute;
  top: 50%;
  left: 0;
  width: 3px;
  height: 22px;
  border-radius: 0 3px 3px 0;
  background: var(--forest);
  transform: translateY(-50%);
  content: "";
}
.menu-results { flex: 1; min-width: 0; padding: 12px var(--store-inset) 5px; }
.menu-feedback { margin: 0 0 10px; padding: 8px 10px; font-size: 13px; overflow-wrap: anywhere; }
.menu-window-conflict { border-radius: 8px; background: var(--mint); color: var(--forest); }
.menu-feedback .link { display: block; min-height: 34px; margin: 0; padding: 4px 0; text-align: left; }
.menu-empty { padding: 38px 6px; font-size: 14px; }
.menu-empty .link { margin-top: 5px; }
.menu-section + .menu-section { margin-top: 13px; }
.menu-section-heading { display: flex; align-items: baseline; gap: 8px; }
.menu-section-title { font-size: 16px; font-weight: 750; overflow-wrap: anywhere; }
.menu-section-count { flex: none; color: var(--muted); font-size: 12px; }

.meal-row { display: flex; align-items: flex-start; gap: 10px; padding: 10px 0; border-bottom: 1px solid var(--line); }
/* 缩略图宽度固定，菜名使用剩余空间。 */
.meal-thumb, .detail-photo, .cart-line-photo { flex: none; overflow: hidden; background: var(--mint); }
.meal-row .meal-thumb { width: 84px; height: 84px; min-height: 0; padding: 0; border-radius: 10px; }
.food-image { display: block; width: 100%; height: 100%; }
.food-placeholder { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; color: var(--forest); }
.food-placeholder image { width: 25px; height: 25px; opacity: .68; }
.meal-info { flex: 1; min-width: 0; }
.meal-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 3px; }
.meal-name { flex: 1; min-width: 0; padding-top: 2px; font-size: 15px; font-weight: 700; line-height: 1.35; overflow-wrap: anywhere; }
.meal-heading .favorite-icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 31px;
  height: 31px;
  min-height: 31px;
  padding: 0;
  background: transparent;
  color: var(--muted);
  font-size: 22px;
  line-height: 1;
}
.meal-heading .favorite-active { color: var(--forest); }
.meal-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 3px 6px; color: var(--muted); font-size: 12px; line-height: 1.4; overflow-wrap: anywhere; }
.meal-tag { padding: 2px 5px; border-radius: 4px; background: var(--mint); color: var(--forest); }
.meal-sold-out { color: #805d39; }
.meal-buy { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 2px 4px; margin-top: 5px; }
.meal-price { min-width: 0; font-size: 18px; font-weight: 750; line-height: 1.1; overflow-wrap: anywhere; }
.meal-price, .showcase-price, .cart-total, .cart-sheet-amount, .cart-line-amount, .detail-price { font-variant-numeric: tabular-nums; }

.quantity { display: flex; flex: none; align-items: center; gap: 4px; margin-left: auto; }
.quantity .quantity-button, .showcase-buy .quantity-button {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  min-height: 32px;
  padding: 0;
  border-radius: 50%;
  color: var(--forest);
  font-size: 22px;
  line-height: 1;
}
.showcase-buy .quantity-button { width: 28px; height: 28px; min-height: 28px; font-size: 20px; }
.quantity-minus { border: 1px solid #cbdcca; background: #fff; }
.quantity-plus { background: var(--lime); color: var(--lime-text); }
.quantity-button[disabled] { background: #ebeee8; color: #657060; opacity: .85; }
.quantity-value { min-width: 15px; color: var(--ink); font-size: 13px; font-weight: 650; text-align: center; }

.cart-dock-area {
  position: fixed;
  z-index: 10;
  right: 0;
  bottom: var(--tab-space);
  left: 0;
  max-width: 580px;
  margin: 0 auto;
  padding: var(--dock-gap) var(--store-inset);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0), #fff 15px);
}
.cart-dock {
  display: flex;
  align-items: center;
  gap: 8px;
  height: var(--cart-height);
  padding: 5px 7px;
  border-radius: 15px;
  background: var(--dark);
  box-shadow: 0 5px 16px rgba(23, 28, 21, .19);
  color: #fff;
}
.cart-summary { display: flex; flex: 1; align-items: center; gap: 9px; width: auto; min-width: 0; padding: 0 0 0 3px; background: transparent; color: inherit; text-align: left; }
.cart-symbol { position: relative; display: flex; flex: none; align-items: center; justify-content: center; width: 38px; height: 38px; border: 1px solid #5c6253; border-radius: 11px; background: #373b30; color: var(--lime); }
.bag-icon { position: relative; width: 17px; height: 15px; margin-top: 5px; border: 1.5px solid currentColor; border-radius: 3px; }
.bag-icon::before { position: absolute; top: -6px; left: 3px; width: 8px; height: 7px; border: 1.5px solid currentColor; border-bottom: 0; border-radius: 6px 6px 0 0; content: ""; }
.cart-count-badge {
  position: absolute;
  top: -5px;
  right: -5px;
  min-width: 17px;
  padding: 0 3px;
  border: 1px solid var(--dark);
  border-radius: 9px;
  background: var(--lime);
  color: var(--lime-text);
  font-size: 10px;
  font-weight: 750;
  line-height: 16px;
  text-align: center;
}
.cart-copy { flex: 1; min-width: 0; line-height: 1.2; }
.cart-total, .cart-empty-label, .cart-caption { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.cart-total { font-size: 23px; font-weight: 750; }
.cart-empty-label { font-size: 15px; font-weight: 650; }
.cart-caption { margin-top: 2px; color: #d8ded1; font-size: 11px; }
.cart-dock .cart-checkout { flex: none; width: 117px; }
.cart-dock .cart-checkout[disabled] { background: #4d5346; color: #e1e5da; }

.home-scrim { position: absolute; inset: 0; }
.order-sheet {
  position: relative;
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 580px;
  max-height: 84vh;
  overflow: hidden;
  padding-bottom: var(--safe-bottom);
  border-radius: 21px 21px 0 0;
  background: #fff;
}
.order-sheet-heading { display: flex; flex: none; align-items: center; justify-content: space-between; gap: 8px; min-height: 58px; padding: 6px 14px 6px 17px; border-bottom: 1px solid var(--line); }
.order-sheet-title { display: block; font-size: 20px; font-weight: 750; }
.sheet-title-group { min-width: 0; }
.cart-window-name { display: block; color: var(--muted); font-size: 12px; overflow-wrap: anywhere; }
.order-sheet-heading .sheet-close { flex: none; width: 42px; min-height: 42px; padding: 0; border-radius: 10px; background: var(--soft); color: var(--ink); font-size: 25px; line-height: 1; }
.order-sheet-body { min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding: 12px 17px 15px; }
.order-sheet-footer { display: flex; flex: none; align-items: center; gap: 13px; padding: 10px 17px 13px; border-top: 1px solid var(--line); }
.sheet-primary { flex: 1; width: auto; }

.detail-product { display: flex; align-items: flex-start; gap: 12px; }
.detail-photo { width: 96px; height: 96px; border-radius: 11px; }
.detail-product-copy { flex: 1; min-width: 0; }
.detail-name { min-width: 0; padding-top: 1px; font-size: 19px; font-weight: 750; line-height: 1.3; overflow-wrap: anywhere; }
.detail-availability { display: block; margin-top: 2px; color: var(--muted); font-size: 13px; }
.detail-price { display: block; margin-top: 6px; color: var(--forest); font-size: 24px; font-weight: 750; line-height: 1.2; }
.detail-unit { color: var(--muted); font-size: 13px; font-weight: 500; }
.detail-tags { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 12px; }
.detail-tags text { max-width: 100%; padding: 3px 7px; border-radius: 5px; background: var(--mint); color: var(--forest); font-size: 12px; overflow-wrap: anywhere; }
.detail-description { display: block; margin-top: 10px; color: var(--muted); font-size: 14px; line-height: 1.6; overflow-wrap: anywhere; }
.detail-quantity { display: flex; align-items: center; justify-content: space-between; margin-top: 12px; padding-top: 11px; border-top: 1px solid var(--line); font-weight: 650; }
.detail-note { display: block; margin-top: 7px; color: var(--muted); font-size: 13px; }

.cart-tools { display: flex; align-items: center; justify-content: space-between; min-height: 34px; margin-top: -5px; color: var(--muted); font-size: 13px; }
.cart-clear { width: auto; min-height: 34px; margin: 0; padding: 5px 0 5px 10px; font-size: 13px; }
.cart-line { display: flex; align-items: center; gap: 9px; padding: 9px 0; border-top: 1px solid var(--line); }
.cart-line-photo { width: 52px; height: 52px; border-radius: 8px; }
.cart-line-copy { flex: 1; min-width: 0; }
.cart-line-name, .cart-line-amount { display: block; overflow-wrap: anywhere; }
.cart-line-name { font-size: 15px; font-weight: 650; }
.cart-line-amount { margin-top: 2px; color: var(--muted); font-size: 13px; }
.cart-sheet-empty { padding: 29px 10px; }
.cart-sheet-total { min-width: 0; max-width: 43%; color: var(--ink); line-height: 1.2; }
.cart-sheet-caption { display: block; color: var(--muted); font-size: 12px; }
.cart-sheet-amount { display: block; font-size: 24px; font-weight: 750; overflow-wrap: anywhere; }

@media (max-width: 350px) {
  .home { --store-inset: 11px; --rail-width: 66px; }
  .store-cover { padding-left: 15px; }
  .store-name { font-size: 17px; }
  .store-mark { width: 39px; height: 39px; }
  .store-switch { gap: 4px; padding: 6px; }
  .meal-row .meal-thumb { width: 68px; height: 74px; }
  .meal-row { gap: 8px; }
  .meal-price { font-size: 17px; }
  .quantity .quantity-button { width: 29px; height: 29px; min-height: 29px; }
  .cart-dock .cart-checkout { width: 102px; }
  .detail-photo { width: 81px; height: 81px; }
}

@media (max-height: 640px) {
  /* 短屏先展示窗口和菜单，餐盘有菜品后再为固定操作区留空间。 */
  .home-empty-cart { --home-dock-space: var(--tab-space); }
  .home-empty-cart .cart-dock-area, .store-cover, .showcase { display: none; }
  .store-card { margin-top: 0; }
}
