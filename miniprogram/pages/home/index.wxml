<page-meta page-style="{{cartOpen || detailDish ? 'overflow: hidden;' : ''}}" />

<template name="food-photo">
  <image wx:if="{{dish.image}}" class="food-image" src="{{dish.image}}" mode="aspectFill"
    lazy-load="{{lazy}}" data-id="{{dish.id}}" binderror="imageError" aria-hidden="true" />
  <view wx:else class="food-placeholder" aria-hidden="true">
    <image src="/assets/tab-bar/meal.svg" mode="aspectFit" />
  </view>
</template>

<template name="quantity">
  <view class="quantity" aria-label="{{'餐盘内有 ' + dish.count + ' 份' + dish.name}}">
    <button wx:if="{{dish.count}}" class="quantity-button quantity-minus" data-id="{{dish.id}}" data-delta="-1"
      disabled="{{locked || dish.invalid}}" bindtap="change" hover-class="pressed" aria-label="{{'减少一份' + dish.name}}">−</button>
    <text wx:if="{{dish.count}}" class="quantity-value">{{dish.count}}</text>
    <button class="quantity-button quantity-plus" data-id="{{dish.id}}" data-delta="1"
      disabled="{{locked || dish.addBlocked || dish.invalid}}" bindtap="change" hover-class="pressed" aria-label="{{'加一份' + dish.name}}">+</button>
  </view>
</template>

<template name="dish-favorite">
  <button class="favorite-icon {{dish.liked ? 'favorite-active' : ''}}" data-id="{{dish.id}}" data-liked="{{dish.liked}}"
    disabled="{{locked}}" bindtap="favorite" hover-class="pressed" aria-label="{{(dish.liked ? '取消收藏' : '收藏') + dish.name}}">
    <text aria-hidden="true">{{dish.liked ? '♥' : '♡'}}</text>
  </button>
</template>

<view class="home dock-metrics {{count ? '' : 'home-empty-cart'}}">
  <view class="store-cover">
    <image class="store-cover-image" src="/assets/images/canteen-cover.jpg" mode="aspectFill" aria-hidden="true" />
    <view class="store-cover-copy">
      <text class="store-cover-title">校园食堂</text>
      <text class="store-cover-title store-cover-accent">预约点餐</text>
      <text class="store-cover-caption">开放今天和明天</text>
    </view>
  </view>

  <view class="store-card">
    <picker class="store-picker" range="{{windows}}" range-key="pickerLabel" value="{{windowIndex}}"
      disabled="{{loading || windows.length < 2}}" bindchange="selectWindow" aria-label="切换食堂窗口">
      <view class="store-identity">
        <view class="store-mark"><image src="/assets/images/fandian-mark.png" mode="aspectFit" aria-hidden="true" /></view>
        <view class="store-labels">
          <text wx:if="{{selected.canteenName}}" class="store-canteen">{{selected.canteenName}}</text>
          <text class="store-name">{{selected.name || (loading ? '正在加载窗口…' : '食堂窗口')}}</text>
        </view>
        <view wx:if="{{windows.length > 1}}" class="store-switch">
          <text>切换窗口</text><view class="chevron chevron-down" aria-hidden="true" />
        </view>
      </view>
    </picker>
    <view wx:if="{{selected.id}}" class="store-pickup">
      <text class="store-mode {{windowClosed ? 'store-paused' : ''}}">{{windowClosed ? '暂停预约' : '预约自取'}}</text>
      <text wx:if="{{selected.location}}" class="store-location">{{selected.location}}</text>
    </view>
  </view>

  <view wx:if="{{featured.length}}" class="showcase">
    <view class="showcase-heading">
      <text class="showcase-title">窗口精选</text>
      <button class="showcase-menu" bindtap="goToMenu" hover-class="pressed">查看菜单<view class="chevron chevron-down" aria-hidden="true" /></button>
    </view>
    <scroll-view scroll-x class="showcase-scroll" aria-label="窗口精选菜品">
      <view class="showcase-track">
        <view wx:for="{{featured}}" wx:key="id" class="showcase-card">
          <button class="showcase-dish" data-id="{{item.id}}" bindtap="openDish" hover-class="pressed" aria-label="{{'查看' + item.name}}">
            <view class="showcase-image">
              <template is="food-photo" data="{{dish: item}}" />
              <text wx:if="{{item.count}}" class="showcase-count" aria-label="{{'已选 ' + item.count + ' 份'}}">×{{item.count}}</text>
            </view>
            <text class="showcase-name">{{item.name}}</text>
          </button>
          <view class="showcase-buy">
            <text class="showcase-price"><text class="currency">¥</text>{{item.priceText}}</text>
            <button class="quantity-button quantity-plus" data-id="{{item.id}}" data-delta="1"
              disabled="{{busy || loading || item.addBlocked}}" bindtap="change" hover-class="pressed"
              aria-label="{{'加一份' + item.name}}">+</button>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 菜单随页面滚动，浏览时搜索栏与分类保持在屏幕上方。 -->
  <view id="menu-start" class="menu-start">
    <view class="menu-tools">
      <view class="menu-search">
        <view class="search-symbol" aria-hidden="true" />
        <input placeholder="搜索菜名或口味" placeholder-class="menu-placeholder" aria-label="搜索菜名或口味"
          confirm-type="search" value="{{query}}" bindinput="search" bindconfirm="goToMenu" />
        <button wx:if="{{query}}" class="search-clear" aria-label="清空搜索" bindtap="clearSearch">×</button>
      </view>
      <button class="menu-favorites {{favoritesOnly ? 'menu-favorites-active' : ''}}" bindtap="favorites" hover-class="pressed"
        aria-label="{{favoritesOnly ? '显示全部菜品' : '只看收藏'}}">
        <text class="menu-heart" aria-hidden="true">{{favoritesOnly ? '♥' : '♡'}}</text><text>收藏</text>
      </button>
    </view>

    <view class="menu-layout {{categories.length > 1 ? 'menu-with-rail' : ''}}">
      <view wx:if="{{categories.length > 1}}" class="category-rail">
        <scroll-view class="category-scroll" scroll-y aria-label="菜品分类">
          <button wx:for="{{categories}}" wx:key="id" class="category-item {{categoryId == item.id ? 'category-current' : ''}}"
            data-id="{{item.id}}" bindtap="category" hover-class="pressed"
            aria-label="{{item.name + (categoryId == item.id ? '，当前分类' : '')}}">{{item.name}}</button>
        </scroll-view>
      </view>

      <view class="menu-results">
        <view wx:if="{{error}}" class="menu-feedback error">
          <text>{{error}}</text>
          <button class="link" disabled="{{loading || busy}}" bindtap="load">重新加载</button>
        </view>
        <view wx:if="{{windowConflict}}" class="menu-feedback menu-window-conflict">
          <text>餐盘已选{{cartWindowName ? '「' + cartWindowName + '」的' : '其他窗口的'}}菜品，一份预约限一个窗口。</text>
          <button class="link" bindtap="openCart">查看餐盘</button>
        </view>
        <view wx:if="{{loading && !menu.length}}" class="empty menu-empty">正在准备菜单…</view>

        <view wx:for="{{groups}}" wx:for-item="group" wx:key="id" class="menu-section">
          <view class="menu-section-heading">
            <text class="menu-section-title">{{group.name}}</text>
            <text class="menu-section-count">{{group.items.length}} 道</text>
          </view>

          <view wx:for="{{group.items}}" wx:key="id" class="meal-row">
            <button class="meal-thumb" data-id="{{item.id}}" bindtap="openDish" hover-class="pressed" aria-label="{{'查看' + item.name}}">
              <template is="food-photo" data="{{dish: item, lazy: true}}" />
            </button>
            <view class="meal-info">
              <view class="meal-heading">
                <view class="meal-name" data-id="{{item.id}}" bindtap="openDish">{{item.name}}</view>
                <template is="dish-favorite" data="{{dish: item, locked: busy || loading}}" />
              </view>
              <view class="meal-meta">
                <text wx:if="{{item.tagLabel}}" class="meal-tag">{{item.tagLabel}}</text>
                <text class="{{item.stock > 0 ? '' : 'meal-sold-out'}}">{{item.stock > 0 ? '余 ' + item.stock + ' 份' : '已售罄'}}</text>
              </view>
              <view class="meal-buy">
                <text class="meal-price"><text class="currency">¥</text>{{item.priceText}}</text>
                <template is="quantity" data="{{dish: item, locked: busy || loading}}" />
              </view>
            </view>
          </view>
        </view>

        <view wx:if="{{!groups.length && !loading && !error}}" class="empty menu-empty">
          <text>{{favoritesOnly ? '当前筛选下没有收藏菜品' : query ? '没有找到相关菜品' : '当前窗口暂无可选菜品'}}</text>
          <button wx:if="{{query}}" class="link" bindtap="clearSearch">清除搜索</button>
          <button wx:elif="{{favoritesOnly}}" class="link" bindtap="favorites">查看全部菜品</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 短屏隐藏空餐盘，为菜单留出空间。 -->
  <view class="cart-dock-area">
    <view class="cart-dock">
      <button class="cart-summary" bindtap="openCart" hover-class="pressed" aria-label="{{'查看餐盘，已选 ' + count + ' 份'}}">
        <view class="cart-symbol" aria-hidden="true">
          <view class="bag-icon" />
          <text wx:if="{{count}}" class="cart-count-badge">{{count}}</text>
        </view>
        <view class="cart-copy">
          <block wx:if="{{count}}">
            <text class="cart-total"><text class="currency">¥</text>{{total}}</text>
            <text class="cart-caption">已选 {{count}} 份</text>
          </block>
          <block wx:else>
            <text class="cart-empty-label">餐盘为空</text>
            <text class="cart-caption">选好菜后预约取餐</text>
          </block>
        </view>
      </button>
      <button class="reservation-button cart-checkout" disabled="{{!count || busy || loading}}" bindtap="checkout" hover-class="pressed">
        去预约<view class="chevron" aria-hidden="true" />
      </button>
    </view>
  </view>
</view>

<view wx:if="{{detailDish || cartOpen}}" class="modal-mask home-overlay dock-metrics">
  <view class="home-scrim" bindtap="closeOverlay" catchtouchmove="keepOverlayPosition" />
  <view wx:if="{{detailDish}}" class="order-sheet detail-sheet" aria-label="菜品详情">
    <view class="order-sheet-heading">
      <text class="order-sheet-title">菜品详情</text>
      <button class="sheet-close" aria-label="关闭菜品详情" bindtap="closeOverlay" hover-class="pressed">×</button>
    </view>
    <view class="order-sheet-body">
      <view class="detail-product">
        <view class="detail-photo"><template is="food-photo" data="{{dish: detailDish}}" /></view>
        <view class="detail-product-copy">
          <view class="meal-heading">
            <text class="detail-name">{{detailDish.name}}</text>
            <template is="dish-favorite" data="{{dish: detailDish, locked: busy || loading}}" />
          </view>
          <text class="detail-availability">{{detailDish.stock > 0 ? '余 ' + detailDish.stock + ' 份' : '已售罄'}}</text>
          <text class="detail-price"><text class="currency">¥</text>{{detailDish.priceText}}<text class="detail-unit"> / 份</text></text>
        </view>
      </view>
      <view wx:if="{{detailDish.tagList.length || detailDish.calories > 0}}" class="detail-tags">
        <text wx:for="{{detailDish.tagList}}" wx:key="*this">{{item}}</text>
        <text wx:if="{{detailDish.calories > 0}}">约 {{detailDish.calories}} kcal</text>
      </view>
      <text wx:if="{{detailDish.description}}" class="detail-description">{{detailDish.description}}</text>
      <view wx:if="{{detailDish.count}}" class="detail-quantity">
        <text>餐盘份数</text>
        <template is="quantity" data="{{dish: detailDish, locked: busy || loading}}" />
      </view>
      <text wx:if="{{detailDish.addBlocked && (detailDish.otherWindow || detailDish.count)}}" class="detail-note">{{detailDish.addBlocked}}</text>
    </view>
    <view class="order-sheet-footer">
      <button wx:if="{{detailDish.otherWindow}}" class="reservation-button sheet-primary" bindtap="openCart" hover-class="pressed">查看当前餐盘</button>
      <button wx:elif="{{detailDish.count}}" class="reservation-button sheet-primary" bindtap="closeOverlay" hover-class="pressed">选好了</button>
      <button wx:else class="reservation-button sheet-primary" data-id="{{detailDish.id}}" data-delta="1"
        disabled="{{busy || loading || detailDish.addBlocked}}" bindtap="change" hover-class="pressed">{{detailDish.addBlocked || '加入餐盘'}}</button>
    </view>
  </view>

  <view wx:else class="order-sheet cart-sheet" aria-label="已选餐盘">
    <view class="order-sheet-heading">
      <view class="sheet-title-group">
        <text class="order-sheet-title">已选餐盘</text>
        <text wx:if="{{cartWindowName}}" class="cart-window-name">{{cartWindowName}}</text>
      </view>
      <button class="sheet-close" aria-label="关闭餐盘" bindtap="closeOverlay" hover-class="pressed">×</button>
    </view>
    <view class="order-sheet-body">
      <block wx:if="{{count}}">
        <view class="cart-tools">
          <text>共 {{count}} 份</text>
          <button class="link cart-clear" disabled="{{busy || loading}}" bindtap="clear" hover-class="pressed">清空餐盘</button>
        </view>
        <view wx:for="{{cartRows}}" wx:key="id" class="cart-line">
          <view class="cart-line-photo"><template is="food-photo" data="{{dish: item}}" /></view>
          <view class="cart-line-copy">
            <text class="cart-line-name">{{item.name}}</text>
            <text class="cart-line-amount">{{item.invalid ? '已下架' : '¥' + item.subtotal}}</text>
          </view>
          <template is="quantity" data="{{dish: item, locked: busy || loading}}" />
        </view>
      </block>
      <view wx:else class="empty cart-sheet-empty">{{loading ? '正在读取餐盘…' : '餐盘还没有菜品'}}</view>
    </view>
    <view class="order-sheet-footer">
      <block wx:if="{{count}}">
        <view class="cart-sheet-total"><text class="cart-sheet-caption">合计</text><text class="cart-sheet-amount"><text class="currency">¥</text>{{total}}</text></view>
        <button class="reservation-button sheet-primary" disabled="{{busy || loading}}" bindtap="checkout" hover-class="pressed">
          去预约<view class="chevron" aria-hidden="true" />
        </button>
      </block>
      <button wx:else class="reservation-button sheet-primary" bindtap="closeOverlay" hover-class="pressed">继续选餐</button>
    </view>
  </view>
</view>
