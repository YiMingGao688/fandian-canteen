<page-meta page-style="{{editing || reviewing || paymentOrder ? 'overflow: hidden;' : ''}}" />
<view class="page tab-page orders-page dock-metrics">
  <view class="section-header">
    <view class="section-intro">
      <view class="title">我的预约</view>
      <view class="muted">取餐时间、凭证和用餐记录</view>
    </view>
    <view class="section-symbol"><image src="/assets/tab-bar/calendar.svg" mode="aspectFit" aria-hidden="true" /></view>
  </view>

  <view wx:if="{{!logged}}" class="empty">
    登录后查看预约
    <button class="primary" bindtap="login">使用学号登录</button>
  </view>
  <block wx:else>
    <scroll-view scroll-x class="chips order-filters">
      <view wx:for="{{tabs}}" wx:key="index" class="chip {{filter === index ? 'active' : ''}}" data-index="{{index}}" bindtap="filter">
        {{item}}
      </view>
    </scroll-view>
    <view wx:if="{{loadError}}" class="error" role="alert">
      <text>预约加载失败。{{loadError}}</text>
      <button class="link" disabled="{{loadingOrders}}" bindtap="retryOrders">重新加载</button>
    </view>
    <view wx:elif="{{loadingOrders && !visible.length}}" class="empty">正在加载预约…</view>
    <view wx:elif="{{!visible.length}}" class="empty">暂时没有这类预约</view>

    <view wx:for="{{visible}}" wx:key="id" class="card order-card">
      <view class="row between order-card-heading">
        <text class="food-name">{{item.windowName}}</text>
        <text class="pill order-status order-status-{{item.status}}">{{item.statusText}}</text>
      </view>
      <view class="order-time">
        <text>{{item.canteenName}} · {{item.serviceDate}}</text>
        <text>{{item.startTime}} – {{item.endTime}}</text>
      </view>
      <view wx:if="{{item.location}}" class="tiny order-location">取餐地点 {{item.location}}</view>
      <view wx:for="{{item.items}}" wx:for-item="line" wx:key="id" class="row split">
        <image class="order-item-image" src="{{line.image}}" mode="aspectFill" />
        <text class="order-item-name">{{line.name}}</text>
        <text>× {{line.number}}</text>
      </view>
      <view wx:if="{{item.pickupCode && item.status >= 2 && item.status <= 4}}" class="ticket {{item.status === 4 ? 'ticket-ready' : ''}}">
        <view class="tiny">到窗出示取餐码</view>
        <view class="code">{{item.pickupCode}}</view>
        <view class="tiny">{{item.status === 4 ? '已备好，请前往窗口取餐' : '等待备餐完成后前往窗口'}}</view>
      </view>
      <view wx:if="{{item.remark}}" class="note">备注：{{item.remark}}</view>
      <view wx:if="{{item.status === 6}}" class="note">{{item.cancelReason || '预约已取消'}}</view>

      <view class="split order-summary">
        <view class="order-total">
          <text class="tiny">预约金额</text>
          <text class="price order-price">¥{{item.amountText}}</text>
        </view>
        <view wx:if="{{item.status === 1 || item.status === 2}}" class="order-actions">
          <button class="link danger" disabled="{{busy}}" data-id="{{item.id}}" bindtap="cancelOrder">取消预约</button>
          <button class="outline" disabled="{{busy}}" data-id="{{item.id}}" bindtap="edit">改约</button>
        </view>
        <view wx:elif="{{item.status === 5}}" class="order-actions">
          <button wx:if="{{!item.reviewed}}" class="outline" disabled="{{busy}}" data-id="{{item.id}}" bindtap="review">评价</button>
          <text wx:else class="tiny">已评价</text>
        </view>
      </view>
      <button wx:if="{{item.status === 1}}" class="primary full order-pay" disabled="{{busy}}" data-id="{{item.id}}" bindtap="openPayment">
        去模拟支付
      </button>
      <view class="tiny order-number">{{item.number}}</view>
    </view>
    <view class="note">模拟支付不扣款。</view>
  </block>
</view>

<view wx:if="{{editing || reviewing}}" class="modal-mask orders-mask" bindtap="close">
  <view class="sheet orders-sheet dock-metrics" catchtap="noop">
    <view class="row between">
      <text class="order-sheet-title">{{editing ? '换个取餐时间' : '这一餐，还好吗？'}}</text>
      <button class="close" aria-label="关闭" disabled="{{busy}}" bindtap="close">×</button>
    </view>
    <block wx:if="{{editing}}">
      <pickup-time
        dates="{{dates}}"
        date-index="{{dateIndex}}"
        slots="{{slots}}"
        slot-index="{{slotIndex}}"
        loading="{{loadingSlots}}"
        failed="{{slotLoadFailed}}"
        busy="{{busy}}"
        bind:datechange="dateChange"
        bind:slotchange="slotChange"
        bind:retry="retrySlots"
      />
      <button class="primary full" disabled="{{busy || loadingSlots || slotIndex < 0}}" bindtap="saveEdit">确认改约</button>
    </block>
    <block wx:else>
      <view class="row review-stars" aria-label="用餐评分">
        <text wx:for="{{[1,2,3,4,5]}}" wx:key="*this" data-rating="{{item}}" bindtap="rate">{{item <= rating ? '★' : '☆'}}</text>
      </view>
      <textarea class="field" value="{{content}}" bindinput="content" maxlength="300" placeholder="味道、分量、服务，都可以聊聊" />
      <button class="primary full" disabled="{{busy}}" bindtap="saveReview">提交评价</button>
    </block>
  </view>
</view>

<view wx:if="{{paymentOrder}}" class="modal-mask orders-mask" bindtap="closePayment">
  <view class="sheet orders-sheet dock-metrics" catchtap="noop" aria-label="模拟收银台">
    <view class="payment-heading">
      <view>
        <text class="order-sheet-title">确认预约支付</text>
        <text class="payment-subtitle">核对金额和取餐信息后继续</text>
      </view>
      <button class="close" aria-label="关闭模拟收银台" disabled="{{busy}}" bindtap="closePayment">×</button>
    </view>
    <view class="payment-total">
      <text class="payment-total-label">本次需支付</text>
      <text class="payment-amount">¥{{paymentOrder.amountText}}</text>
    </view>
    <view class="payment-details">
      <view class="row between payment-window">
        <text class="muted">取餐窗口</text>
        <text>{{paymentOrder.windowName}}</text>
      </view>
      <view class="row between payment-window">
        <text class="muted">取餐时间</text>
        <text>{{paymentOrder.serviceDate}} · {{paymentOrder.startTime}}–{{paymentOrder.endTime}}</text>
      </view>
      <view wx:if="{{paymentOrder.location}}" class="payment-location">{{paymentOrder.location}}</view>
    </view>
    <view wx:if="{{paymentError}}" class="error" role="alert">{{paymentError}}</view>
    <button class="primary full" disabled="{{busy}}" bindtap="confirmPayment">{{busy ? '处理中…' : (paymentError ? '重试模拟支付' : '确认模拟支付')}}</button>
    <view class="payment-options">
      <button class="outline" disabled="{{busy}}" bindtap="failPayment">模拟支付失败</button>
      <button class="outline" disabled="{{busy}}" bindtap="closePayment">取消付款</button>
    </view>
    <text class="payment-footnote">本页面为本地演示，模拟支付不会扣款。</text>
  </view>
</view>
