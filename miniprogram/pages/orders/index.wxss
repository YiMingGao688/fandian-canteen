page {
  overflow-x: hidden;
}

.orders-page {
  width: 100%;
  min-height: 100vh;
  background-color: #f8f7f1;
}

/* 原生导航与页面交界使用同一底色，覆盖切页时顶部残留的像素。 */
.orders-top-edge {
  position: fixed;
  z-index: 1;
  top: 0;
  right: 0;
  left: 0;
  height: 2px;
  background-color: #f8f7f1;
  pointer-events: none;
}

.orders-intro {
  margin: 16rpx 0;
}

.order-filters,
.order-card {
  width: 100%;
  max-width: 100%;
}

.food-name {
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
}

.order-status,
.order-item-image {
  flex-shrink: 0;
}

.order-time {
  margin: 18rpx 0;
}

.order-item-image {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
}

.order-item-name {
  flex: 1;
  min-width: 0;
  overflow-wrap: break-word;
}

.order-summary {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx 18rpx;
}

.order-price {
  white-space: nowrap;
}

.order-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  max-width: 100%;
  margin-left: auto;
}

.order-actions button {
  flex: none;
  width: auto;
  min-width: 44px;
  min-height: 44px;
  margin: 0;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  white-space: nowrap;
}

.order-pay {
  width: 100%;
  min-height: 44px;
  margin: 16rpx 0 0;
  font-weight: 600;
}

.order-number {
  margin-top: 18rpx;
  overflow-wrap: break-word;
}

.ticket {
  margin-top: 26rpx;
  padding: 26rpx;
  border: 1rpx dashed #b8c69e;
  border-radius: 16rpx;
  background: #eaf0df;
}

.code {
  margin: 8rpx 0;
  color: #345337;
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
}

.order-sheet-title {
  min-width: 0;
  font-size: 36rpx;
  font-weight: 650;
}

.orders-mask .close {
  flex: none;
  width: 44px;
  min-height: 44px;
  margin: 0;
  padding: 0;
}

.orders-mask .full {
  width: 100%;
  min-height: 44px;
}

.review-stars {
  margin-top: 30rpx;
  color: #b58c48;
  font-size: 48rpx;
}

.payment-total {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  margin: 22rpx 0;
  padding: 28rpx 16rpx;
  border-radius: 22rpx;
  background: #eaf0e1;
}

.payment-amount {
  color: #294f39;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.2;
}

.payment-window {
  gap: 24rpx;
  padding: 12rpx 0;
}

.payment-window text:last-child {
  flex: 1;
  min-width: 0;
  text-align: right;
  overflow-wrap: break-word;
}

.payment-options {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.payment-options button {
  flex: 1 1 0;
  width: auto;
  min-width: 0;
  min-height: 44px;
  margin: 0;
  padding-right: 12rpx;
  padding-left: 12rpx;
  white-space: nowrap;
}
