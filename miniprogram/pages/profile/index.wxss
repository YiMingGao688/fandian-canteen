.profile-card{padding:48rpx 22rpx;margin-bottom:26rpx;background:#e9efdf;border-radius:28rpx;text-align:center}.profile-card .title{font-size:36rpx}.profile-card .note{margin:15rpx 0 25rpx}.profile-card button{display:inline-block;padding:18rpx 35rpx}.avatar{margin:0 auto 25rpx;background:#d6e3c7;color:#486640;border-radius:50%;width:110rpx;height:110rpx;line-height:110rpx;font-size:45rpx}.menu-link{display:flex;justify-content:space-between;padding:26rpx 0;border-bottom:1rpx solid #edf0e6}.menu-link:last-child{border:0}.menu-link text:last-child{font-size:23rpx;color:#819076}
